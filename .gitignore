# ============================================================
#  HealthOpt / DFinder — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
*.egg-info/

# ── Logs & temp files ────────────────────────────────────────
*.log
*.err
finetune_log.txt
predict_called.log
translator_called.log
api_debug.log
import_check.log
test_write.log
cloudflared*.log
verify_*.txt
verify_log*.txt
train_final_report.txt
cleaning_report_final.txt
train_mapping_report.txt

# ── Runtime / generated files ────────────────────────────────
web/healthopt.db
web/healthopt.db-shm
web/healthopt.db-wal
web/dist/
web/server.log
web/server_err.log
web/server_output.log
web/server_test.log
web/server.err
web/test_output.txt

# ── Model weights & embeddings (use Git LFS instead) ─────────
*.pth.tar
*.pth
*.pt
*.h5
*.npy
*.npz
*.pkl
*.joblib

# ── Databases (too large / contain sensitive data) ───────────
chembl_36_sqlite/
full\ database.xml
*.db
*.db-shm
*.db-wal
*.sqlite

# ── Large raw data files (>50 MB — not for GitHub) ───────────
# FooDB raw tables (source: foodb.ca)
Content.csv
Compound.csv
Food.csv

# HKG graph files (generated by scripts/build_hkg_triplets.py)
data/processed_hkg/hkg_triplets.tsv
data/processed_hkg/hkg_food_compound_edges.csv
data/processed_hkg/kge_input/train.txt

# LightGCN feature files (>50 MB text)
DFinder-main/data/unified-DFI/feature_extra/unified_drug_feature_extra.txt
DFinder-main/data/unified-DFI/feature_extra/unified_food_feature_extra.txt

# ChEMBL chemical representations (725 MB)
chembl_36_chemreps.txt

# DrugBank full XML export (1.9 GB) — requires DrugBank license
# Download from: https://go.drugbank.com/releases/latest
# full database.xml   ← already covered by *.xml rule below

# USDA FoodData Central raw export (28 MB — borderline, excluded for cleanliness)
FoodData_Central_foundation_food_csv_2025-04-24/

# ── All XML files (includes full database.xml) ────────────────
*.xml

# ── NHANES survey data (1.2 GB of .xpt files) ────────────────
mon_projet_nutrition/data/

# ── Backup checkpoints (1.3 GB) ──────────────────────────────
checkpoints_backup/

# ── Deploy artifacts ─────────────────────────────────────────
dfinder-deploy.tar.gz
*.tar.gz

# ── Personal / private files ─────────────────────────────────
# Blood test PDFs (personal medical documents)
blood\ tests/

# Thesis PDF (submit separately)
thesis__*.pdf

# ── Editor & OS ──────────────────────────────────────────────
.vscode/
.windsurf/
.DS_Store
Thumbs.db

# ── Node.js ──────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Misc build outputs ────────────────────────────────────────
dist/
build/

# ── Markdown docs (keep only STRUCTURE.md) ───────────────────
*.md
!README.md
